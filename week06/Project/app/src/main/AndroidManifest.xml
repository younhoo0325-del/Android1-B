<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Project">

        <!-- 메인 화면 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 과일 목록 화면 -->
        <activity
            android:name=".CustomListActivity"
            android:exported="false" />

        <!-- 과일 선택 결과 화면 -->
        <activity
            android:name=".CustomResultActivity"
            android:exported="false" />

        <activity android:name=".RecyclerViewActivity" android:exported="false" />
        <activity android:name=".ExpandableListActivity" android:exported="false" />
        <activity android:name=".SpinnerActivity" android:exported="false" />
        <activity android:name=".CustomSpinnerActivity" android:exported="false" />
        <activity android:name=".GridViewActivity" android:exported="false" />
        <activity android:name=".GalleryActivity" android:exported="false" />
        <activity android:name=".SampleListActivity" android:exported="false" />
        <activity android:name=".CustomGridActivity" android:exported="false" />
    </application>

</manifest>
